# Worker environment. Never commit real values. The secret key bypasses RLS: worker/server only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Live analysis (leave empty to run probe/purge only; coaches can still review manually)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=true
# Google Gemini (ANALYSIS_PROVIDER=gemini). On Google's free tier, submitted video frames may be used to improve
# Google products and read by human reviewers: use it only with clips whose owners agreed to that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# anthropic | gemini
ANALYSIS_PROVIDER=gemini
# Test-only: ANALYSIS_PROVIDER=mock is refused unless SMARVII_TEST_MODE=1
SMARVII_TEST_MODE=0
# Health endpoint port (Render sets PORT automatically)
HEALTH_PORT=8080
# Optional tuning
JOB_LEASE_SECONDS=120
POLL_SECONDS=3
GYM_SAMPLE_FPS=4
SOFTBALL_SAMPLE_FPS=10
MAX_FRAMES_PER_REQUEST=48
FRAME_LONG_EDGE_PX=768
# Optional cost-estimate overrides (USD per million tokens)
PROVIDER_INPUT_USD_PER_MTOK=
PROVIDER_OUTPUT_USD_PER_MTOK=
